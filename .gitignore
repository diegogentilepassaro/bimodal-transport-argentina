# ==============================================================================
# .gitignore — Argentina transport replication package (new_repo/)
# ==============================================================================

# ---- Raw data files (large; only readmes and .gitkeep are committed) -------
# Data files in any format — replicators obtain these per readme.md instructions
data/raw/**/*.dta
data/raw/**/*.csv
data/raw/**/*.xlsx
data/raw/**/*.xls
data/raw/**/*.parquet
data/raw/**/*.sav
data/raw/**/*.dat
data/raw/**/*.dat.gz
data/raw/**/*.zip
data/raw/**/*.shp
data/raw/**/*.shx
data/raw/**/*.dbf
data/raw/**/*.prj
data/raw/**/*.cpg
data/raw/**/*.sbn
data/raw/**/*.sbx
data/raw/**/*.qpj
data/raw/**/*.gpkg
data/raw/**/*.geojson
data/raw/**/*.xml
data/raw/**/*.pdf
data/raw/**/*.txt
# Keep readmes and .gitkeep
!data/raw/**/readme.md
!data/raw/**/.gitkeep

# ---- Generated data (everything under data/derived/) ----------------------
data/derived/**
!data/derived/.gitkeep
# Keep data file manifests (documentation of what the code produces)
# Must un-ignore parent dirs for the exception to work
!data/derived/base/
!data/derived/base/*/
!data/derived/02_hypothetical_networks/
!data/derived/06_analysis/
!data/derived/**/data_file_manifest*.log

# ---- Generated results (re-created by running main.R) ---------------------
# Tables: commit CSV (GitHub-readable) so coauthors can see numbers in-repo.
# Keep .tex gitignored since they're consumed by paper.tex at compile time.
results/tables/*.tex
# Figures: commit PNG (GitHub-previewable) so coauthors can see visuals.
# Keep .pdf gitignored since they're consumed by paper.tex at compile time.
results/figures/*.pdf
# scalars.tex is an AutoFill macro file generated by
# code/analysis/generate_scalars.R; keep local to compilation but
# regenerable. Gitignored (follows the .tex rule).
results/scalars.tex

# ---- Log files (directory kept via .gitkeep) -------------------------------
logs/*.Rout
*.Rout
# Keep run logs (evidence of successful execution)
!logs/clean_*.log

# ---- R session artefacts ---------------------------------------------------
.Rhistory
.RData
.Rproj.user/

# ---- renv cache (not the lockfile) -----------------------------------------
renv/library/
renv/staging/
renv/.cache/

# ---- Python bytecode -------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ---- Python virtual environments -------------------------------------------
.venv/
venv/
env/

# ---- macOS / editor noise --------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ---- LaTeX build artefacts -------------------------------------------------
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.bbl
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
# Commit the built PDFs (paper.pdf + paper_planned.pdf) so coauthors
# and reviewers can read the latest draft without running LaTeX.
# Everything *.pdf else lives outside paper/ and is covered by specific rules.

# ---- Raw data files (large; only readmes and .gitkeep committed) -----------
data/raw/**/*.xlsx
data/raw/**/*.dta
data/raw/**/*.csv
data/raw/**/*.sav

# ---- Large spatial files ---------------------------------------------------
*.tif
*.geotiff
*.img

# ---- .gitkeep files ARE committed ------------------------------------------
!**/.gitkeep

# ---- Exception: 1960 geocoding (own digitization) ---------------------------
# Two different things live in this folder and the reasons differ:
#   - the digitization itself (transcription, ledgers, pinned API caches):
#     produced by us, NOT obtainable from third parties, and not
#     regenerable, so it belongs in git;
#   - ref/: third-party reference geometry and a codebook, REDISTRIBUTED
#     here for convenience. Provenance and licence are pending (issue
#     raised on PR #146) and the 55 MB geojson is a candidate for removal
#     in favour of a documented download.
#
# SCOPED BY EXTENSION ON PURPOSE (cr-review PR #146). A recursive
# "!.../geocoding_1960/**" sits after every rule above it and so overrode
# them all for this subtree, including *.tif and the large-file rules --
# any file of any size dropped in here would have been committed
# silently. Add a line when a new extension is genuinely needed.
!data/raw/census/geocoding_1960/
!data/raw/census/geocoding_1960/**/
!data/raw/census/geocoding_1960/**/*.csv
!data/raw/census/geocoding_1960/**/*.md
!data/raw/census/geocoding_1960/**/*.json
!data/raw/census/geocoding_1960/**/*.html
# ref/: enumerated file by file, so nothing new lands here unnoticed.
!data/raw/census/geocoding_1960/ref/deptos_argentina.geojson
!data/raw/census/geocoding_1960/ref/ar60divp.pdf
